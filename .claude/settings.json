      { "hooks": [{ "type": "command", "command": ".harness/hooks/pre-tool-use/enforce-arch.sh" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": ".harness/hooks/post-tool-use/capture-lesson.sh" }] }
