---
import BaseLayout from './BaseLayout.astro';
import TagBadge from '../components/TagBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  portfolio: CollectionEntry<'portfolio'>;
  Content: any;
}

const { portfolio, Content } = Astro.props;
const publishDate = new Date(portfolio.data.date);
---
<BaseLayout
  title={portfolio.data.title}
  description={portfolio.data.description}
  type="article"
  publishedDate={publishDate.toISOString()}
  tags={portfolio.data.tags}
>
  <article class="prose-post">
    <!-- Header -->
    <header class="mb-10 pb-8 border-b" style="border-color: var(--color-border);">
      <div class="flex flex-wrap gap-1.5 mb-4">
        {portfolio.data.featured && (
          <span
            class="inline-block px-2.5 py-1 text-xs font-medium rounded whitespace-nowrap"
            style="background: var(--color-tag-bg); color: var(--color-tag-text);"
          >
            Featured
          </span>
        )}
        {portfolio.data.tags.map((tag) => <TagBadge tag={tag} />)}
      </div>
      <h1 class="text-3xl font-bold leading-tight mb-4" style="color: var(--color-text);">
        {portfolio.data.title}
      </h1>
      {portfolio.data.description && (
        <p class="text-lg mb-5" style="color: var(--color-text-muted);">{portfolio.data.description}</p>
      )}
      <div class="flex items-center gap-3 text-sm" style="color: var(--color-text-muted);">
        <time datetime={publishDate.toISOString()}>
          {publishDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
    </header>

    <!-- Portfolio body -->
    <div class="notion-content">
      <Content />
    </div>

    <!-- Back link -->
    <div class="mt-16 pt-8 border-t" style="border-color: var(--color-border);">
      <a
        href="/portfolio/"
        class="text-sm font-medium transition-colors hover:opacity-80"
        style="color: var(--color-accent);"
      >
        ← 포트폴리오 목록으로
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .notion-content {
    color: var(--color-text);
    line-height: 1.8;
    font-size: 1rem;
  }

  .notion-content :global(h1),
  .notion-content :global(h2),
  .notion-content :global(h3),
  .notion-content :global(h4) {
    color: var(--color-text);
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .notion-content :global(h1) { font-size: 1.875rem; }
  .notion-content :global(h2) { font-size: 1.5rem; }
  .notion-content :global(h3) { font-size: 1.25rem; }

  .notion-content :global(p) {
    margin: 0.875rem 0;
  }

  .notion-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .notion-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  .notion-content :global(ul),
  .notion-content :global(ol) {
    padding-left: 1.5rem;
    margin: 0.875rem 0;
  }

  .notion-content :global(ul) { list-style-type: disc; }
  .notion-content :global(ol) { list-style-type: decimal; }

  .notion-content :global(li) {
    margin: 0.375rem 0;
  }

  .notion-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .notion-content :global(code:not(.astro-code code)) {
    background-color: var(--color-bg-secondary);
    color: var(--color-accent);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  .notion-content :global(img) {
    max-width: 100%;
    border-radius: 0.5rem;
    margin: 1.5rem auto;
    display: block;
  }

  .notion-content :global(hr) {
    border-color: var(--color-border);
    margin: 2rem 0;
  }

  .notion-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.9375rem;
  }

  .notion-content :global(th),
  .notion-content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.625rem 0.875rem;
    text-align: left;
  }

  .notion-content :global(th) {
    background-color: var(--color-bg-secondary);
    font-weight: 600;
  }
</style>
