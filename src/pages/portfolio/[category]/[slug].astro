---
import { getCollection, render } from 'astro:content';
import PortfolioDetailLayout from '../../../layouts/PortfolioDetailLayout.astro';
import { normalizeSlug } from '../../../lib/portfolio';
import { filterVisible } from '../../../lib/content-visibility';

export async function getStaticPaths() {
  const portfolios = filterVisible(await getCollection('portfolio'));

  return portfolios.map((portfolio) => {
    const [categoryLower, filename] = portfolio.id.split('/');
    const slug = normalizeSlug(filename);

    return {
      params: {
        category: categoryLower, // 소문자로 통일 (URL에서 사용)
        slug: slug,
      },
      props: { portfolio },
    };
  });
}

const { portfolio } = Astro.props;
const { Content } = await render(portfolio);
---
<PortfolioDetailLayout portfolio={portfolio} Content={Content} />
