---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import matter from 'gray-matter';
import BaseLayout from '../layouts/BaseLayout.astro';

const raw = readFileSync(resolve(process.cwd(), 'src/data/resume.md'), 'utf-8');
const { data, content: summaryBody } = matter(raw);
const personal = data.personal;
const experiences = data.experiences;
const techStack = data.techStack;
const education = data.education;
const summary = summaryBody.trim();
---

<BaseLayout
  title="이력서 | tskim"
  description="김태수 — Senior Data Engineer. 대규모 데이터 인프라 현대화, AI 에이전트 개발, 데이터 거버넌스 구축 경험."
>
  <!-- Hero -->
  <section
    class="mb-12 pb-8 border-b"
    style="border-color: var(--color-border);"
  >
    <h1 class="text-4xl font-bold mb-2" style="color: var(--color-text);">{personal.name}</h1>
    <p class="text-xl font-medium mb-4" style="color: var(--color-accent);">{personal.title}</p>
    <div class="flex flex-wrap gap-4 text-sm" style="color: var(--color-text-muted);">
      <a
        href={`mailto:${personal.email}`}
        class="hover:underline"
        style="color: var(--color-accent);"
      >
        {personal.email}
      </a>
      <a
        href={personal.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline"
        style="color: var(--color-accent);"
      >
        {personal.github}
      </a>
      {personal.portfolioUrl && (
        <a
          href={personal.portfolioUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline"
          style="color: var(--color-accent);"
        >
          {personal.portfolio}
        </a>
      )}
    </div>
  </section>

  <!-- Professional Summary -->
  <section
    class="mb-12"
  >
    <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">Professional Summary</h2>
    <div class="space-y-4">
      {summary.split('\n\n').map((paragraph) => (
        <p class="leading-relaxed" style="color: var(--color-text-muted);">
          {paragraph}
        </p>
      ))}
    </div>
  </section>

  <!-- Professional Experience -->
  <section
    class="mb-12"
  >
    <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">Professional Experience</h2>

    {experiences.map((exp, expIdx) => (
      <div class={expIdx < experiences.length - 1 ? 'mb-10' : 'mb-2'}>
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between mb-1">
          <h3 class="text-lg font-bold" style="color: var(--color-text);">
            {exp.company} ({exp.companyEn})
          </h3>
          <span class="text-sm" style="color: var(--color-text-muted);">{exp.period}</span>
        </div>
        <p class="text-sm font-medium mb-6" style="color: var(--color-accent);">{exp.role}</p>

        <!-- Timeline -->
        <div class="relative border-l-2 pl-6 space-y-8" style="border-color: var(--color-border);">
          {exp.projects.map((project) => (
            <div class="relative">
              <span
                class="absolute -left-[1.4375rem] top-1 w-3 h-3 rounded-full border-2 flex-shrink-0"
                style={project.accent
                  ? 'background-color: var(--color-accent); border-color: var(--color-accent);'
                  : 'background-color: var(--color-border); border-color: var(--color-border);'}
              ></span>
              {project.title && (
                <div class="flex flex-wrap items-baseline gap-2 mb-1">
                  <h4 class="font-semibold" style="color: var(--color-text);">
                    {project.title}
                  </h4>
                  {project.period && (
                    <span class="text-xs" style="color: var(--color-text-muted);">{project.period}</span>
                  )}
                </div>
              )}
              {project.problem && (
                <p class="text-xs mb-2 italic" style="color: var(--color-text-muted);">
                  Problem: {project.problem}
                </p>
              )}
              <ul class="space-y-1 text-sm list-disc list-inside" style="color: var(--color-text-muted);">
                {project.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Core Technical Stack -->
  <section
    class="mb-12"
  >
    <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">Core Technical Stack</h2>
    <div class="space-y-4">
      {techStack.map(({ category, skills }) => (
        <div class="flex flex-col sm:flex-row sm:items-start gap-2">
          <span
            class="text-sm font-semibold w-full sm:w-40 flex-shrink-0 pt-0.5"
            style="color: var(--color-text-muted);"
          >
            {category}
          </span>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span
                class="inline-block px-2 py-0.5 text-sm rounded"
                style="background: var(--color-tag-bg); color: var(--color-tag-text);"
              >
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section
    class="mb-4"
  >
    <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text);">Education</h2>
    <div class="relative border-l-2 pl-6" style="border-color: var(--color-border);">
      {education.map((edu) => (
        <div class="relative">
          <span
            class="absolute -left-[1.4375rem] top-1 w-3 h-3 rounded-full border-2 flex-shrink-0"
            style="background-color: var(--color-border); border-color: var(--color-border);"
          ></span>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
            <div>
              <h3 class="font-semibold" style="color: var(--color-text);">{edu.school}</h3>
              <p class="text-sm" style="color: var(--color-text-muted);">{edu.major}</p>
            </div>
            <span class="text-sm" style="color: var(--color-text-muted);">{edu.period}</span>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
