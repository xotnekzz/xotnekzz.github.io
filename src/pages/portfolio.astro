---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioTabs from '../components/PortfolioTabs.astro';
import type { Portfolio } from '../lib/types';
import {
  extractCategory,
  groupByCategory,
  sortByDateDesc,
} from '../lib/portfolio';

// 포트폴리오 파일 동적 로딩
const portfolioFiles = import.meta.glob('../content/portfolio/*/*.md', {
  eager: true,
}) as Record<string, any>;

// 메타데이터 추출 및 정렬
const projects: Portfolio[] = Object.entries(portfolioFiles)
  .map(([path, module]) => {
    const frontmatter = module.frontmatter || {};
    return {
      title: frontmatter.title || '',
      description: frontmatter.description || '',
      date: frontmatter.date || '',
      tags: frontmatter.tags || [],
      featured: frontmatter.featured || false,
      category: extractCategory(path),
    } as Portfolio;
  })
  .filter((p) => p.title && p.date) // 필수 필드 검증
  .sort((a, b) => {
    // featured 항목 우선, 그 다음 날짜 내림차순
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return new Date(b.date).valueOf() - new Date(a.date).valueOf();
  });

// 카테고리별 그룹화
const grouped = groupByCategory(projects);

// 카테고리 알파벳 순 정렬
const sortedCategories = Object.keys(grouped).sort();
---

<BaseLayout
  title="Portfolio | tskim"
  description="김태수의 프로젝트 포트폴리오"
>
  <section class="mb-12 pb-8 border-b" style="border-color: var(--color-border);">
    <h1 class="text-4xl font-bold mb-2" style="color: var(--color-text);">
      Portfolio
    </h1>
    <p class="text-lg" style="color: var(--color-text-muted);">
      주요 프로젝트 및 경험
    </p>
  </section>

  <section>
    <PortfolioTabs categories={sortedCategories} data={grouped} />
  </section>
</BaseLayout>
