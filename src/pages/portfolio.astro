---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioTabs from '../components/PortfolioTabs.astro';
import { getCollection } from 'astro:content';
import type { Portfolio } from '../lib/types';
import { groupByCategory, sortByDateDesc, normalizeSlug } from '../lib/portfolio';
import { filterVisible, isDraft } from '../lib/content-visibility';

// Astro Content Collection으로 포트폴리오 로드 (draft 필터 적용)
const portfolioEntries = filterVisible(await getCollection('portfolio'));

interface PortfolioWithSlug extends Portfolio {
  slug: string;
}

// 카테고리명 매핑 (소문자로 정규화된 경로를 원본 대소문자로 복원)
const categoryMap: Record<string, string> = {
  aienginerring: 'AIEnginerring',
  analyticsenginering: 'AnalyticsEnginering',
  dataengineering: 'DataEngineering',
  governance: 'Governance',
};

// 메타데이터 추출 및 정렬
const projects: PortfolioWithSlug[] = portfolioEntries
  .map((entry) => {
    const { data } = entry;
    const categoryLower = entry.id.split('/')[0];
    const categoryDisplay = categoryMap[categoryLower] || categoryLower;
    const filename = entry.id.split('/')[1];

    return {
      title: data.title || '',
      description: data.description || '',
      date: data.date || '',
      tags: data.tags || [],
      featured: data.featured || false,
      draft: isDraft(entry),
      category: categoryDisplay, // 원본 대소문자로 복원된 카테고리명
      slug: normalizeSlug(filename), // Astro URL-safe 슬러그로 정규화
    } as PortfolioWithSlug;
  })
  .filter((p) => p.title && p.date) // 필수 필드 검증
  .sort((a, b) => {
    // featured 항목 우선, 그 다음 날짜 내림차순
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return new Date(b.date).valueOf() - new Date(a.date).valueOf();
  });

// 카테고리별 그룹화
const grouped = groupByCategory(projects);

// 카테고리 알파벳 순 정렬
const sortedCategories = Object.keys(grouped).sort();
---

<BaseLayout
  title="Portfolio | tskim"
  description="김태수의 프로젝트 포트폴리오"
>
  <section class="mb-12 pb-8 border-b" style="border-color: var(--color-border);">
    <h1 class="text-4xl font-bold mb-2" style="color: var(--color-text);">
      Portfolio
    </h1>
    <p class="text-lg" style="color: var(--color-text-muted);">
      주요 프로젝트 및 경험
    </p>
  </section>

  <section>
    <PortfolioTabs categories={sortedCategories} data={grouped} />
  </section>
</BaseLayout>
