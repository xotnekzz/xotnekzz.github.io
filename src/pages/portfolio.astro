---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Portfolio } from '../lib/types';
import {
  extractCategory,
  groupByCategory,
  sortByDateDesc,
  formatDateKorean,
} from '../lib/portfolio';

// 포트폴리오 파일 동적 로딩
const portfolioFiles = import.meta.glob('../content/portfolio/*/*.md', {
  eager: true,
}) as Record<string, any>;

// 메타데이터 추출 및 정렬
const projects: Portfolio[] = Object.entries(portfolioFiles)
  .map(([path, module]) => {
    const frontmatter = module.frontmatter || {};
    return {
      title: frontmatter.title || '',
      description: frontmatter.description || '',
      date: frontmatter.date || '',
      tags: frontmatter.tags || [],
      featured: frontmatter.featured || false,
      category: extractCategory(path),
    } as Portfolio;
  })
  .filter((p) => p.title && p.date) // 필수 필드 검증
  .sort((a, b) => {
    // featured 항목 우선, 그 다음 날짜 내림차순
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    return new Date(b.date).valueOf() - new Date(a.date).valueOf();
  });

// 카테고리별 그룹화
const grouped = groupByCategory(projects);

// 카테고리 알파벳 순 정렬
const sortedCategories = Object.keys(grouped).sort();
---

<BaseLayout
  title="Portfolio | tskim"
  description="김태수의 프로젝트 포트폴리오"
>
  <section class="mb-12 pb-8 border-b" style="border-color: var(--color-border);">
    <h1 class="text-4xl font-bold mb-2" style="color: var(--color-text);">
      Portfolio
    </h1>
    <p class="text-lg" style="color: var(--color-text-muted);">
      주요 프로젝트 및 경험
    </p>
  </section>

  <section>
    <div class="space-y-12">
      {
        sortedCategories.map((category) => (
          <div>
            <h2
              class="text-2xl font-bold mb-6"
              style="color: var(--color-text);"
            >
              {category}
            </h2>

            <div class="space-y-8">
              {grouped[category].map((project) => (
                <div
                  class="pb-8 border-b last:border-b-0"
                  style="border-color: var(--color-border);"
                >
                  <div class="flex items-start justify-between gap-4 mb-2">
                    <h3
                      class="text-xl font-semibold flex-1"
                      style="color: var(--color-text);"
                    >
                      {project.title}
                    </h3>
                    {project.featured && (
                      <span
                        class="inline-block px-2 py-1 text-xs font-medium rounded whitespace-nowrap"
                        style="background: var(--color-tag-bg); color: var(--color-tag-text);"
                      >
                        Featured
                      </span>
                    )}
                  </div>

                  <p
                    class="text-sm mb-4"
                    style="color: var(--color-text-muted);"
                  >
                    {formatDateKorean(project.date)}
                  </p>

                  <p
                    class="mb-4"
                    style="color: var(--color-text-muted);"
                  >
                    {project.description}
                  </p>

                  <div class="flex flex-wrap gap-2">
                    {project.tags.map((tag) => (
                      <span
                        class="inline-block px-2 py-1 text-xs rounded"
                        style="background: var(--color-tag-bg); color: var(--color-tag-text);"
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
