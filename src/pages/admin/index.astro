---
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>관리자 대시보드</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: system-ui, sans-serif;
        background: #0d1117;
        color: #e6edf3;
        min-height: 100vh;
        padding: 2rem 1rem;
      }
      .container { max-width: 800px; margin: 0 auto; }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
      }
      h1 { font-size: 1.5rem; font-weight: 700; }
      .actions { display: flex; gap: 0.75rem; }
      a.btn, button.btn {
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        border: none;
      }
      a.btn-primary { background: #238636; color: #fff; }
      a.btn-primary:hover { background: #2ea043; }
      button.btn-secondary { background: #21262d; color: #e6edf3; border: 1px solid #30363d; }
      button.btn-secondary:hover { background: #30363d; }
      table { width: 100%; border-collapse: collapse; }
      th, td {
        text-align: left;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #21262d;
        font-size: 0.875rem;
      }
      th { color: #8b949e; font-weight: 600; }
      td { color: #e6edf3; }
      .tag {
        display: inline-block;
        background: #21262d;
        color: #8b949e;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        margin-right: 0.25rem;
      }
      .empty { color: #8b949e; text-align: center; padding: 3rem; }
      .loading { color: #8b949e; text-align: center; padding: 3rem; }
      .error-msg { color: #f85149; text-align: center; padding: 3rem; }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <h1>관리자 대시보드</h1>
        <div class="actions">
          <a href="/admin/new" class="btn btn-primary">새 글 쓰기</a>
          <button class="btn btn-secondary" id="logout-btn">로그아웃</button>
        </div>
      </header>

      <table>
        <thead>
          <tr>
            <th>파일명</th>
            <th>경로</th>
          </tr>
        </thead>
        <tbody id="posts-tbody">
          <tr>
            <td colspan="2" class="loading">포스트 목록을 불러오는 중...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <script>
      const REPO_OWNER = 'xotnekzz';
      const REPO_NAME = 'xotnekzz.github.io';

      const pat = sessionStorage.getItem('github_pat');
      if (!pat) {
        window.location.href = '/admin/login';
      }

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        sessionStorage.removeItem('github_pat');
        window.location.href = '/admin/login';
      });

      async function loadPosts() {
        const tbody = document.getElementById('posts-tbody') as HTMLTableSectionElement;
        try {
          const res = await fetch(
            `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/src/content/posts`,
            {
              headers: {
                'Authorization': `Bearer ${pat}`,
                'Accept': 'application/vnd.github+json',
              },
            }
          );

          if (!res.ok) {
            throw new Error(`GitHub API 오류: ${res.status}`);
          }

          const items: Array<{ name: string; path: string; type: string }> = await res.json();

          // Collect all .md files, including those in subdirectories
          const mdFiles: Array<{ name: string; path: string }> = [];

          for (const item of items) {
            if (item.type === 'dir') {
              const subRes = await fetch(
                `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${item.path}`,
                {
                  headers: {
                    'Authorization': `Bearer ${pat}`,
                    'Accept': 'application/vnd.github+json',
                  },
                }
              );
              if (subRes.ok) {
                const subItems: Array<{ name: string; path: string; type: string }> = await subRes.json();
                for (const sub of subItems) {
                  if (sub.type === 'file' && sub.name.endsWith('.md')) {
                    mdFiles.push({ name: sub.name, path: sub.path });
                  }
                }
              }
            } else if (item.type === 'file' && item.name.endsWith('.md')) {
              mdFiles.push({ name: item.name, path: item.path });
            }
          }

          if (mdFiles.length === 0) {
            tbody.innerHTML = '<tr><td colspan="2" class="empty">포스트가 없습니다.</td></tr>';
            return;
          }

          tbody.innerHTML = mdFiles.map((f) => `
            <tr>
              <td>${f.name}</td>
              <td style="color: #8b949e; font-family: monospace; font-size: 0.8rem;">${f.path}</td>
            </tr>
          `).join('');
        } catch (err: unknown) {
          const msg = err instanceof Error ? err.message : '알 수 없는 오류';
          tbody.innerHTML = `<tr><td colspan="2" class="error-msg">오류: ${msg}</td></tr>`;
        }
      }

      if (pat) {
        loadPosts();
      }
    </script>
  </body>
</html>
