---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagBadge from '../components/TagBadge.astro';
import { getCollection } from 'astro:content';
import type { TagInfo } from '../lib/types.js';
import { SITE } from '../config/site';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const recent = posts.filter((p) => !p.data.featured).slice(0, 6);

// Top tags
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const topTags: TagInfo[] = [...tagMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([name, count]) => ({ name, count }));
---
<BaseLayout
  title={SITE.title}
  description={SITE.description}
>
  <!-- Hero -->
  <section class="mb-14">
    <h1 class="text-4xl font-bold mb-3" style="color: var(--color-text);">{SITE.home.headline}</h1>
    <p class="text-lg" style="color: var(--color-text-muted);">
      {SITE.home.tagline}
    </p>
  </section>

  <!-- Featured posts -->
  {featured.length > 0 && (
    <section class="mb-14">
      <h2 class="text-xl font-bold mb-5 flex items-center gap-2" style="color: var(--color-text);">
        <span>📌</span> 추천 포스트
      </h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  <!-- Recent posts -->
  {recent.length > 0 && (
    <section class="mb-14">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-bold" style="color: var(--color-text);">최근 포스트</h2>
        <a href="/blog/" class="text-sm font-medium" style="color: var(--color-accent);">
          전체 보기 →
        </a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {recent.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  <!-- Top tags -->
  {topTags.length > 0 && (
    <section>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold" style="color: var(--color-text);">태그</h2>
        <a href="/tags/" class="text-sm font-medium" style="color: var(--color-accent);">
          전체 태그 →
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {topTags.map(({ name }) => <TagBadge tag={name} />)}
      </div>
    </section>
  )}
</BaseLayout>
