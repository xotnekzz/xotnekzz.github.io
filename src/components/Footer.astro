---
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---
<footer class="border-t mt-16 py-8" style="border-color: var(--color-border);">
  <div class="max-w-3xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm" style="color: var(--color-text-muted);">
    <p>© {year} {SITE.author.name}. All rights reserved.</p>
    <div class="flex items-center gap-4">
      {SITE.footer.links.map(({ href, label }) => (
        <a
          href={href}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="hover:text-[var(--color-accent)] transition-colors"
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</footer>
