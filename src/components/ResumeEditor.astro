---
// 개발 모드 전용: 이력서 더블클릭 에디터 컴포넌트
// 이 컴포넌트는 isDev === false일 때 빌드에 포함되지 않음 (tree-shaking)
---

<script>
  // 개발 모드 전용: 더블클릭해서 inline edit
  if (import.meta.env.DEV) {
    interface EditableElement {
      element: Element;
      originalText: string;
    }

    let currentEditing: EditableElement | null = null;

    // 편집 가능한 모든 텍스트 요소에 더블클릭 이벤트 추가
    document.addEventListener('dblclick', (e: MouseEvent) => {
      const target = e.target as HTMLElement;

      // 이미 입력 중이면 무시
      if (currentEditing) return;

      // 편집 가능한 요소 찾기 (h1, h2, h3, p, span)
      if (!['H1', 'H2', 'H3', 'P', 'SPAN'].includes(target.tagName)) return;

      // 편집 불가능한 부분 제외
      if (target.closest('a') || target.closest('button')) return;

      // 부모 섹션이 editable-section인지 확인
      const editableSection = target.closest('.editable-section');
      if (!editableSection) return;

      startEditing(target);
    });

    function startEditing(element: Element) {
      const originalText = element.textContent || '';
      currentEditing = { element, originalText };

      // 입력 필드 생성
      const input = document.createElement('input');
      input.type = 'text';
      input.value = originalText;
      input.className = 'resume-editor-inline-input';
      input.style.cssText = `
        width: 100%;
        padding: 0.5rem;
        border: 2px solid #2563eb;
        border-radius: 0.375rem;
        font-size: 1rem;
        font-family: inherit;
      `;

      // 원본 요소 숨기고 입력 필드 삽입
      element.style.display = 'none';
      element.parentNode?.insertBefore(input, element);

      // 포커스 및 선택
      input.focus();
      input.select();

      // 저장 핸들러
      function save() {
        const newText = input.value.trim();
        if (newText) {
          element.textContent = newText;
        }
        cleanup();
      }

      // 정리 핸들러
      function cleanup() {
        element.style.display = '';
        input.remove();
        currentEditing = null;
        input.removeEventListener('blur', save);
        input.removeEventListener('keydown', handleKeydown);
      }

      // 키 이벤트
      function handleKeydown(e: KeyboardEvent) {
        if (e.key === 'Enter') {
          save();
        } else if (e.key === 'Escape') {
          cleanup();
        }
      }

      input.addEventListener('blur', save);
      input.addEventListener('keydown', handleKeydown);
    }

    console.log('Resume double-click editor initialized (dev mode only)');
  }
</script>

<style>
  /* Double-click edit inline input styles */
  .resume-editor-inline-input {
    border: 2px solid var(--color-accent) !important;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    font-size: 1rem !important;
  }

  .editable-section {
    cursor: default;
  }

  .editable-section h1,
  .editable-section h2,
  .editable-section h3,
  .editable-section p,
  .editable-section span {
    cursor: text;
    user-select: none;
    transition: background-color 0.2s;
  }

  .editable-section h1:hover,
  .editable-section h2:hover,
  .editable-section h3:hover,
  .editable-section p:hover,
  .editable-section span:hover {
    background-color: rgba(37, 99, 235, 0.1);
  }
</style>
