---
// 개발 모드 전용: 이력서 더블클릭 에디터 컴포넌트
// 이 컴포넌트는 isDev === false일 때 빌드에 포함되지 않음 (tree-shaking)
---

<script>
  // 개발 모드 전용: 더블클릭해서 inline edit
  if (import.meta.env.DEV) {
    interface EditableElement {
      element: Element;
      originalText: string;
    }

    let currentEditing: EditableElement | null = null;

    // localStorage 관리
    const STORAGE_KEY = 'resume-edits';

    function loadEdits() {
      try {
        const data = localStorage.getItem(STORAGE_KEY);
        return data ? JSON.parse(data) : {};
      } catch (e) {
        return {};
      }
    }

    function saveEditToStorage(selector: string, value: string) {
      const edits = loadEdits();
      edits[selector] = value;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(edits));
    }

    // 페이지 로드 시 저장된 편집사항 복원
    function restoreSavedEdits() {
      const edits = loadEdits();
      Object.entries(edits).forEach(([selector, value]) => {
        try {
          const elements = document.querySelectorAll(selector);
          elements.forEach((el) => {
            if (el.textContent !== value) {
              el.textContent = value as string;
            }
          });
        } catch (e) {
          // selector가 유효하지 않으면 무시
        }
      });
    }

    // 편집 가능한 모든 텍스트 요소에 더블클릭 이벤트 추가
    document.addEventListener('dblclick', (e: MouseEvent) => {
      const target = e.target as HTMLElement;

      // 이미 입력 중이면 무시
      if (currentEditing) return;

      // 편집 불가능한 부분 제외
      if (target.closest('a') || target.closest('button') || target.closest('input') || target.closest('textarea')) {
        return;
      }

      // 부모 섹션이 editable-section인지 확인
      const editableSection = target.closest('.editable-section');
      if (!editableSection) return;

      // H2 섹션 제목은 resume.ts에 대응 필드 없음 → 편집 불가
      if (target.tagName === 'H2' || target.closest('h2')) return;

      // 텍스트가 있는 요소면 편집 가능
      const text = target.textContent?.trim();
      if (text) {
        startEditing(target);
      }
    });

    function startEditing(element: Element) {
      const originalText = element.textContent || '';
      currentEditing = { element, originalText };

      // 요소의 필드 경로 생성 (resume.ts의 필드명을 정확히 파악)
      const editableSection = element.closest('.editable-section');
      let fieldPath = '';

      if (editableSection?.classList.contains('editable-section')) {
        const elementText = (element.textContent || '').trim();

        // Hero 섹션 필드 식별
        if (element.tagName === 'H1') {
          fieldPath = 'personal.name';
        } else if (element.tagName === 'P' && element.style.color?.includes('color-accent')) {
          fieldPath = 'personal.title';
        } else if (element.tagName === 'A' && element.getAttribute('href')?.startsWith('mailto:')) {
          fieldPath = 'personal.email';
        } else if (element.tagName === 'A' && element.getAttribute('href')?.includes('github')) {
          fieldPath = 'personal.github';
        }
        // Summary 섹션 필드 식별
        else if (editableSection.querySelector('h2')?.textContent?.includes('Professional Summary')) {
          fieldPath = 'summary';
        }
        // Experience 섹션 필드 식별
        else if (editableSection.querySelector('h2')?.textContent?.includes('Professional Experience')) {
          if (element.tagName === 'H3') {
            const companyText = element.textContent || '';
            fieldPath = `experience.company|${companyText}`;
          }
        }
        // Tech Stack 섹션 필드 식별
        else if (editableSection.querySelector('h2')?.textContent?.includes('Core Technical Stack')) {
          if (element.tagName === 'SPAN' && element.parentElement?.classList.contains('flex')) {
            // category name
            fieldPath = `techstack.category|${elementText}`;
          }
        }
        // Education 섹션 필드 식별
        else if (editableSection.querySelector('h2')?.textContent?.includes('Education')) {
          if (element.tagName === 'H3') {
            fieldPath = `education.school|${elementText}`;
          } else if (element.tagName === 'P') {
            fieldPath = `education.major|${elementText}`;
          }
        }
      }

      // fallback: 정확한 필드를 찾지 못한 경우
      const fieldIdentifier = fieldPath || `${element.tagName.toLowerCase()}|${originalText.substring(0, 30)}`;

      // 텍스트 길이에 따라 input 또는 textarea 사용
      const isLongText = originalText.length > 100 || originalText.includes('\n');

      let input: HTMLInputElement | HTMLTextAreaElement;
      if (isLongText) {
        input = document.createElement('textarea');
        (input as HTMLTextAreaElement).rows = Math.max(3, Math.ceil(originalText.length / 50));
      } else {
        input = document.createElement('input');
        (input as HTMLInputElement).type = 'text';
      }

      input.value = originalText;
      input.className = 'resume-editor-inline-input';
      input.style.cssText = `
        width: 100%;
        padding: 0.5rem;
        border: 2px solid #2563eb;
        border-radius: 0.375rem;
        font-size: 1rem;
        font-family: inherit;
        box-sizing: border-box;
      `;

      // 원본 요소 숨기고 입력 필드 삽입
      element.style.display = 'none';
      element.parentNode?.insertBefore(input, element);

      // 포커스 및 선택
      input.focus();
      input.select();

      // textarea 높이 자동 조절
      if (isLongText && input instanceof HTMLTextAreaElement) {
        input.addEventListener('input', () => {
          input.style.height = 'auto';
          input.style.height = Math.max(100, input.scrollHeight) + 'px';
        });
      }

      // 저장 핸들러
      function save() {
        const newText = input.value.trim();
        if (newText && newText !== originalText) {
          element.textContent = newText;
          // localStorage에 저장
          if (fieldIdentifier) {
            saveEditToStorage(fieldIdentifier, newText);
          }
        }
        cleanup();
      }

      // 정리 핸들러
      function cleanup() {
        element.style.display = '';
        input.remove();
        currentEditing = null;
        input.removeEventListener('blur', save);
        input.removeEventListener('keydown', handleKeydown);
      }

      // 키 이벤트
      function handleKeydown(e: KeyboardEvent) {
        if (e.key === 'Enter' && !isLongText) {
          save();
        } else if (e.key === 'Escape') {
          cleanup();
        }
      }

      input.addEventListener('blur', save);
      input.addEventListener('keydown', handleKeydown);
    }

    // 페이지 로드 후 저장된 편집사항 복원
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', restoreSavedEdits);
    } else {
      restoreSavedEdits();
    }

    // "파일에 저장" 버튼 추가
    function addSaveButton() {
      const header = document.querySelector('header');
      if (!header) return;

      // 기존 버튼이 있으면 제거
      const existing = document.getElementById('resume-save-btn');
      if (existing) existing.remove();

      const saveBtn = document.createElement('button');
      saveBtn.id = 'resume-save-btn';
      saveBtn.textContent = '📝 파일에 저장';
      saveBtn.style.cssText = `
        margin-left: 1rem;
        padding: 0.5rem 1rem;
        background-color: #10b981;
        color: white;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.875rem;
        transition: background-color 0.2s;
      `;

      saveBtn.addEventListener('mouseover', () => {
        saveBtn.style.backgroundColor = '#059669';
      });
      saveBtn.addEventListener('mouseout', () => {
        saveBtn.style.backgroundColor = '#10b981';
      });

      saveBtn.addEventListener('click', async () => {
        const edits = loadEdits();
        if (Object.keys(edits).length === 0) {
          alert('저장할 수정사항이 없습니다.');
          return;
        }

        saveBtn.disabled = true;
        saveBtn.textContent = '저장 중...';

        try {
          console.log('Sending edits to API:', edits);

          const response = await fetch('/api/save-resume', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ edits }),
          });

          console.log('Response status:', response.status);
          console.log('Response headers:', response.headers);

          const responseText = await response.text();
          console.log('Response text:', responseText);

          let result;
          try {
            result = JSON.parse(responseText);
          } catch (parseError) {
            console.error('JSON parse error:', parseError);
            throw new Error(`응답이 유효한 JSON이 아닙니다:\n${responseText}`);
          }

          if (response.ok) {
            alert(`✅ ${result.edits}개 항목이 resume.ts에 저장되었습니다!\n\n경로: ${result.savedTo}\n\n페이지가 새로고침됩니다.`);
            // localStorage 초기화
            localStorage.removeItem(STORAGE_KEY);
            // 페이지 새로고침
            setTimeout(() => window.location.reload(), 500);
          } else {
            alert(`❌ 저장 실패 (${response.status}):\n${result.error}\n\n${result.details || ''}`);
          }
        } catch (error) {
          console.error('Save error:', error);
          alert(`❌ 저장 실패:\n${error instanceof Error ? error.message : String(error)}`);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = '📝 파일에 저장';
        }
      });

      // 네비게이션 끝에 버튼 추가
      const nav = header.querySelector('nav');
      if (nav) {
        nav.parentNode?.insertBefore(saveBtn, nav.nextSibling);
      } else {
        header.appendChild(saveBtn);
      }
    }

    // DOM 로드 후 버튼 추가
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', addSaveButton);
    } else {
      addSaveButton();
    }

    console.log('Resume double-click editor initialized (dev mode only)');
  }
</script>

<style>
  /* Double-click edit inline input/textarea styles */
  .resume-editor-inline-input {
    border: 2px solid var(--color-accent) !important;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    font-size: 1rem !important;
    line-height: 1.6 !important;
    resize: vertical;
  }

  .editable-section {
    cursor: default;
  }

  /* 모든 텍스트 노드의 부모 요소를 편집 가능하게 */
  .editable-section * {
    cursor: text;
    user-select: none;
    transition: background-color 0.2s;
  }

  /* 링크와 버튼은 제외 */
  .editable-section a,
  .editable-section button {
    cursor: pointer;
    user-select: auto;
  }

  .editable-section *:hover:not(a):not(button) {
    background-color: rgba(37, 99, 235, 0.1);
  }

  /* H2 섹션 제목은 편집 불가 — 호버 효과 제거 */
  .editable-section h2 {
    cursor: default;
  }

  .editable-section h2:hover {
    background-color: transparent;
  }
</style>
