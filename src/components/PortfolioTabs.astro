---
import type { Portfolio } from '../lib/types';
import { formatDateKorean } from '../lib/portfolio';

interface PortfolioWithSlug extends Portfolio {
  slug?: string;
}

export interface Props {
  categories: string[];
  data: Record<string, PortfolioWithSlug[]>;
}

const { categories, data } = Astro.props;

const showDrafts = import.meta.env.DEV;
---

<div class="portfolio-tabs-wrapper">
  {/* 탭 네비게이션 */}
  <div class="tabs-nav" role="tablist" aria-label="포트폴리오 카테고리">
    {
      categories.map((category, index) => (
        <button
          class={`tab-button ${index === 0 ? 'active' : ''}`}
          role="tab"
          aria-selected={index === 0}
          aria-controls={`panel-${category}`}
          id={`tab-${category}`}
          data-tab={category}
        >
          {category}
        </button>
      ))
    }
  </div>

  {/* 콘텐츠 패널 */}
  <div class="tabs-content">
    {
      categories.map((category, index) => (
        <div
          class={`tab-panel ${index === 0 ? 'active' : ''}`}
          role="tabpanel"
          id={`panel-${category}`}
          aria-labelledby={`tab-${category}`}
        >
          <div class="space-y-8">
            {data[category].map((project) => (
              <a
                href={`/portfolio/${project.category.toLowerCase()}/${project.slug}/`}
                class="project-link pb-8 border-b last:border-b-0 block transition-opacity hover:opacity-80"
                style="border-color: var(--color-border);"
              >
                <div class="flex items-start justify-between gap-4 mb-2">
                  <h3
                    class="text-xl font-semibold flex-1"
                    style="color: var(--color-text);"
                  >
                    {project.title}
                  </h3>
                  {showDrafts && project.draft && (
                    <span
                      class="inline-block px-2 py-1 text-xs font-semibold rounded whitespace-nowrap uppercase tracking-wide"
                      style="background-color: var(--color-accent); color: var(--color-bg);"
                    >
                      DRAFT
                    </span>
                  )}
                  {project.featured && (
                    <span
                      class="inline-block px-2 py-1 text-xs font-medium rounded whitespace-nowrap"
                      style="background: var(--color-tag-bg); color: var(--color-tag-text);"
                    >
                      Featured
                    </span>
                  )}
                </div>

                <p
                  class="text-sm mb-4"
                  style="color: var(--color-text-muted);"
                >
                  {formatDateKorean(project.date)}
                </p>

                <p
                  class="mb-4"
                  style="color: var(--color-text-muted);"
                >
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span
                      class="inline-block px-2 py-1 text-xs rounded"
                      style="background: var(--color-tag-bg); color: var(--color-tag-text);"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('[role="tab"]');
    const tabPanels = document.querySelectorAll('[role="tabpanel"]');

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const tabName = button.getAttribute('data-tab');

        // 모든 탭 비활성화
        tabButtons.forEach((btn) => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });

        // 모든 패널 숨김
        tabPanels.forEach((panel) => {
          panel.classList.remove('active');
        });

        // 선택한 탭 활성화
        button.classList.add('active');
        button.setAttribute('aria-selected', 'true');

        // 선택한 패널 표시
        const activePanel = document.querySelector(
          `[role="tabpanel"][id="panel-${tabName}"]`
        );
        if (activePanel) {
          activePanel.classList.add('active');
        }
      });

      // Enter/Space 키로도 활성화 가능
      button.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          (button as HTMLButtonElement).click();
        }
      });
    });

    // 화살표 키로 탭 전환
    tabButtons.forEach((button, index) => {
      button.addEventListener('keydown', (e) => {
        let nextButton: HTMLElement | null = null;

        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextButton =
            index > 0
              ? (tabButtons[index - 1] as HTMLElement)
              : (tabButtons[tabButtons.length - 1] as HTMLElement);
        } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextButton =
            index < tabButtons.length - 1
              ? (tabButtons[index + 1] as HTMLElement)
              : (tabButtons[0] as HTMLElement);
        }

        if (nextButton) {
          (nextButton as HTMLButtonElement).focus();
          (nextButton as HTMLButtonElement).click();
        }
      });
    });
  });
</script>

<style>
  .portfolio-tabs-wrapper {
    width: 100%;
  }

  .tabs-nav {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    margin-bottom: 2rem;
    padding-bottom: 0;
  }

  .tab-button {
    padding: 0.75rem 1rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    color: var(--color-text-muted);
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
    outline: 2px solid transparent;
    outline-offset: 2px;
  }

  .tab-button:hover {
    color: var(--color-text);
  }

  .tab-button:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .tab-button.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
    font-weight: 600;
  }

  .tabs-content {
    width: 100%;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  .project-link {
    text-decoration: none;
    color: inherit;
  }

  .project-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .tabs-nav {
      gap: 0.25rem;
    }

    .tab-button {
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
    }
  }
</style>
