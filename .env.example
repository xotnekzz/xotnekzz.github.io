# Notion Internal Integration Token
# 획득: https://www.notion.so/my-integrations > "새 통합 만들기" > Internal Integration Token
NOTION_API_KEY=secret_your_notion_internal_integration_token

# Notion 데이터베이스 ID
# 획득: Notion DB 페이지 URL에서 32자리 hex ID 추출
# 예시 URL: https://notion.so/workspace/abc123def456...?v=...
#            ^^^^^^^^^^^^^^^^^^^^^^^^^ 이 부분이 DATABASE_ID
NOTION_DATABASE_ID=your_32_char_database_id
